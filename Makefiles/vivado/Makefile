#-----------------------------------------------------------------------------
# File       : Makefile
# Author     : Konstantin Schmidt (mr_pleasant@gmx.de)
# Company    : OHRZ
# Created    : 2023-12-20
#-----------------------------------------------------------------------------
# Description:
# FLOW=vivado: Vivado project from firmware/targets/<platform>/scripts/<version>/<design>.tcl,
# bitstream (+ .bit.bin on SoC boards), XSA export.  MiSTer designs <platform>_<core>[_hdmi] have no
# Tcl of their own: the board's <platform>_mister.tcl generates them for CORE and VIDEO_TX.
#-----------------------------------------------------------------------------
# Copyright (c) 2021-2026 by OHRZ
#-----------------------------------------------------------------------------

#-----------------------------------------------------------------------------
# Board profile, supported platforms, Vivado version (Makefiles/common.mk)
#-----------------------------------------------------------------------------
include $(dir $(lastword $(MAKEFILE_LIST)))../common.mk

# parallel synthesis/implementation runs of build
VIVADO_JOBS			?= 16

# common Tcl scripts and BIFs (firmware/common/scripts, seen from the hw directory)
COMMON_SCRIPTS		:= ../../../../common/scripts
include firmware/common/checkouts.mk
# board profile (platform.mk): PLATFORM_ARCH zynq|zynqmp (bootgen, .bit.bin), VIVADO_XSA_EXPORT_ARGS
# (--fixed: XSA without bitstream), VIVADO_SETUP_CHECKOUTS (make setup clones these sources of checkouts.txt)
BOOTGEN_ARCH		:= $(PLATFORM_ARCH)
XSA_EXPORT_ARGS		:= $(VIVADO_XSA_EXPORT_ARGS)

# MiSTer designs: CORE=<core> (profile firmware/common/mister/cores/<core>/core.tcl) and VIDEO_TX
# (or VIDEO) dvi|hdmi name the design <platform>_<core>[_hdmi]; TOPLEVEL=<platform>_<core>[_hdmi] is
# the same design.  A design with a generator Tcl of its own (scripts/<version>/<TOPLEVEL>.tcl) keeps
# it; every other design is generated by the board design <platform>_mister.tcl with the core and the
# video output parsed from the name.
ifneq ($(strip $(CORE)),)
TOPLEVEL			:= $(PLATFORM)_$(CORE)$(if $(filter hdmi,$(VIDEO_TX)),_hdmi)
endif
DESIGN_SCRIPTS		:= firmware/targets/$(PLATFORM)/scripts/$(VIVADO_VER)
ifneq ($(wildcard $(DESIGN_SCRIPTS)/$(TOPLEVEL).tcl),)
CREATE_TCL			:= $(TOPLEVEL).tcl
CREATE_ARGS			:= $(PLATFORM)
else
MISTER_DESIGN		:= $(patsubst $(PLATFORM)_%,%,$(TOPLEVEL))
MISTER_VIDEO		:= $(if $(filter %_hdmi,$(MISTER_DESIGN)),hdmi,dvi)
MISTER_CORE			:= $(patsubst %_hdmi,%,$(MISTER_DESIGN))
CREATE_TCL			:= $(PLATFORM)_mister.tcl
CREATE_ARGS			:= $(PLATFORM) $(MISTER_CORE) $(MISTER_VIDEO)
endif

# project targets need TOPLEVEL (create and clean remove hw/$(TOPLEVEL))
ifneq ($(filter create build xsa-export clean,$(MAKECMDGOALS)),)
ifeq ($(strip $(TOPLEVEL)),)
$(error	"TOPLEVEL or CORE is not set, e.g. CORE=msx [VIDEO_TX=hdmi] or TOPLEVEL=$(PLATFORM)_msx")
endif
endif

#-----------------------------------------------------------------------------
# Help
#-----------------------------------------------------------------------------
.PHONY: help clean

help::
	@echo 'FLOW=vivado: Vivado projects from firmware/targets/<platform>/scripts/<version>/<design>.tcl'
	@echo ''
	@echo '  PLATFORM=<platform> CORE=<core> [VIDEO_TX=dvi|hdmi] FLOW=vivado make <action>   MiSTer design <platform>_<core>[_hdmi]'
	@echo '  PLATFORM=<platform> TOPLEVEL=<design> FLOW=vivado make <action>                   any design (MiSTer: <platform>_<core>[_hdmi])'
	@echo '    create      project in firmware/build/<platform>/<version>/hw/<design> (removes it first)'
	@echo '    build       synthesis + implementation, hw/bins/<design>.bit (+ .bit.bin on SoC boards)'
	@echo '    xsa-export  hw/<design>.xsa'
	@echo '    launch      Vivado GUI in the hw directory'
	@echo '    setup       external sources of the designs in _Checkouts (VIVADO_SETUP_CHECKOUTS of the board)'
	@echo '    clean       remove the project hw/<design> (bins/ and the XSA stay)'
	@echo ''
	@echo '  VIVADO_JOBS=<n>   parallel runs of build (default $(VIVADO_JOBS))'
	@echo '  cores: $(notdir $(patsubst %/core.tcl,%,$(filter-out %/_template/core.tcl,$(wildcard firmware/common/mister/cores/*/core.tcl))))'
	@echo '  platforms: $(SUPPORTED_PLATFORMS)'

#-----------------------------------------------------------------------------
# Remove the Vivado project of TOPLEVEL (the bitstreams in hw/bins and the XSA stay)
#-----------------------------------------------------------------------------
clean:
	rm -rf firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/$(TOPLEVEL)

#-----------------------------------------------------------------------------
# Launch vivado
#-----------------------------------------------------------------------------
launch:
	@$(ECHO) "Launch VIVADO "$(VIVADO_VER)
	mkdir -p firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw
	cd firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw; vivado -verbose &

#-----------------------------------------------------------------------------
# Create Vivado project
#-----------------------------------------------------------------------------
create:
	@$(ECHO) "Create Vivado "$(VIVADO_VER)" Project "
	@$(ECHO) "Platform "$(PLATFORM)
ifneq ($(MISTER_CORE),)
	@test -f firmware/common/mister/cores/$(MISTER_CORE)/core.tcl || { echo "ERROR: $(TOPLEVEL): no generator $(DESIGN_SCRIPTS)/$(TOPLEVEL).tcl and no core profile firmware/common/mister/cores/$(MISTER_CORE)/core.tcl"; exit 1; }
	@test -f $(DESIGN_SCRIPTS)/$(CREATE_TCL) || { echo "ERROR: $(TOPLEVEL): board $(PLATFORM) has no MiSTer design $(DESIGN_SCRIPTS)/$(CREATE_TCL)"; exit 1; }
	@$(ECHO) "MiSTer design $(TOPLEVEL): core $(MISTER_CORE), video $(MISTER_VIDEO)"
endif
        # clean before build
	rm -rf firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/$(TOPLEVEL)

        # create directory for Vivado PRJ
	mkdir -p firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw

#	the project scripts reference $origin_dir/../../constraints and the board files from here
	cp -r firmware/targets/$(PLATFORM)/board_files firmware/build/$(PLATFORM)/
	cp -r firmware/targets/$(PLATFORM)/constraints firmware/build/$(PLATFORM)/

	cd firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw; vivado -mode batch -notrace -source ../../../../targets/$(PLATFORM)/scripts/$(VIVADO_VER)/$(CREATE_TCL) -tclargs $(CREATE_ARGS)

#-----------------------------------------------------------------------------
# Build Vivado project
#-----------------------------------------------------------------------------
build:
	@$(ECHO) "Build Vivado "$(VIVADO_VER)" project "

	cd firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw; vivado -mode batch -notrace -source $(COMMON_SCRIPTS)/build-vivado-project.tcl -tclargs --project_name $(TOPLEVEL) --jobs $(VIVADO_JOBS)

	mkdir -p firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/bins

	# constraints that matched nothing in the implemented design (a renamed instance drops a generated clock
	# silently, the timing report then checks the wrong period): stop before the bitstream is copied
	@log=firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/$(TOPLEVEL)/$(TOPLEVEL).runs/impl_1/runme.log;			\
	if grep -E '\[Vivado 12-(180|508|4739)\]' $$log; then									\
	  echo "ERROR: constraints without objects in impl_1 ($$log)"; exit 1; fi

	# the bitstream of impl_1 under the name of the design (several designs can be built at the same time)
	@set -e; bits=$$(ls firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/$(TOPLEVEL)/$(TOPLEVEL).runs/impl_1/*.bit);	\
	[ "$$(echo $$bits | wc -w)" = 1 ] || { echo "ERROR: expected one bitstream in impl_1, found: $$bits"; exit 1; };	\
	echo "cp $$bits -> hw/bins/$(TOPLEVEL).bit";											\
	cp $$bits firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/bins/$(TOPLEVEL).bit

#	byte-swapped .bit.bin for the fpga_manager (bootgen names it after the input)
	sed 's/design_1_wrapper\.bit/$(TOPLEVEL).bit/' firmware/common/scripts/convert_bit2bin_$(BOOTGEN_ARCH).bif	\
		> firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/bins/$(TOPLEVEL).bif
	cd firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/bins/; bootgen -w -arch $(BOOTGEN_ARCH) -image $(TOPLEVEL).bif -process_bitstream bin
	rm -f firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/bins/$(TOPLEVEL).bif

#-----------------------------------------------------------------------------
# Export XSA
#-----------------------------------------------------------------------------
xsa-export:
	@$(ECHO) "Exporting XSA file from vivado project"
	cd firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw; vivado -mode batch -notrace -source $(COMMON_SCRIPTS)/export-xsa-from-vivado.tcl -tclargs --project_name $(TOPLEVEL) $(XSA_EXPORT_ARGS)
	@$(ECHO) "XSA: firmware/build/$(PLATFORM)/$(VIVADO_VER)/hw/$(TOPLEVEL).xsa"

#-----------------------------------------------------------------------------
# External sources of the designs
#-----------------------------------------------------------------------------
setup:
	@$(ECHO) "External sources of the $(PLATFORM) designs: $(VIVADO_SETUP_CHECKOUTS)"
#	firmware/common/checkouts.txt: Digilent vivado-library (rgb2dvi), MiSTer framework and cores
	$(foreach c,$(VIVADO_SETUP_CHECKOUTS),$(CHECKOUT_SH) $(c) &&) true

# Makefile ends here
