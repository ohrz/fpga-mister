roms/
# lab addresses of another lab (firmware/common/lab.mk)
lab.local.mk
firmware/build/

# Vivado / Vitis tool output
.Xil/
.crashReporter/
*.jou
*.log
*.str
vivado_pid*.zip

# generated next to the sources (xsa-export)
firmware/targets/*/scripts/design.xsa
firmware/targets/*/scripts/psu_init*
firmware/targets/*/scripts/*.bit

# editor backups, python
*~
__pycache__/

# kernel module and Vitis BSP build output
*.o
*.ko
*.mod
*.mod.c
.*.cmd
modules.order
Module.symvers

# no binaries in Git: kernel image and packages come from
