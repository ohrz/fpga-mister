# Board kernel options on top of xilinx_zynq_defconfig and firmware/common/linux/kernel.config (UIO),
# merged by FLOW=kernel make build (scripts/kconfig/merge_config.sh, then olddefconfig).
#
# MiSTer on the Zybo Z7-20: input devices for Main_MiSTer (evdev), USB keyboards/gamepads and a
# USB Bluetooth adapter on the USB host port (PS4/PS5 controllers over Bluetooth: hid-playstation,
# hid-sony), FPGA manager for the cores (already in the defconfig).

# input: evdev, joystick, uinput (Main_MiSTer creates virtual devices); INPUT_MISC and
# INPUT_JOYSTICK are the menus of uinput and xpad, off in the defconfig
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_FF_MEMLESS=y

# USB HID, gamepads
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
# hid-playstation (DualSense, DualShock 4) depends on the multicolor LED class (light bar)
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_NINTENDO=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y

# Bluetooth over a USB adapter (classic HID: DualSense, DualShock 4)
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_CRYPTO_ECDH=y
