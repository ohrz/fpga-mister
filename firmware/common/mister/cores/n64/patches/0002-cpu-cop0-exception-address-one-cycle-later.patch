+   -- fpga-mister: the exception address (BadVAddr, Context/XContext BadVPN, EntryHi VPN/region) is written one
+   -- cycle later from registers (timing); readers see the pending value (eff_*), so every output is the same
+   signal excW_pend                       : std_logic := '0';                      -- BadVAddr, Context, XContext
+   signal excW_pendHi                     : std_logic := '0';                      -- EntryHi (TLBR cancels it)
+   signal excW_addr                       : unsigned(63 downto 0) := (others => '0');
+   signal eff_BADVIRTUALADDRESS           : unsigned(63 downto 0);
+   signal eff_CONTEXT_BADVPN              : unsigned(18 downto 0);
+   signal eff_ENTRYHI_virtualAddress      : unsigned(26 downto 0);
+   signal eff_ENTRYHI_region              : unsigned(1 downto 0);
+   signal eff_XCONTEXT_Region             : unsigned(1 downto 0);
+   signal eff_XCONTEXT_BadVPN             : unsigned(26 downto 0);
    signal COP0_26_PARITYERROR             : unsigned(7 downto 0) := (others => '0');  
    signal COP0_28_TAGLO_primaryCacheState : unsigned(1 downto 0) := (others => '0');     
    signal COP0_28_TAGLO_physicalAddress   : unsigned(19 downto 0) := (others => '0');     
@@ -338,6 +350,13 @@
