+   eff_CONTEXT_BADVPN         <= excW_addr(31 downto 13)   when (excW_pend = '1')   else COP0_4_CONTEXT_BADVPN;
+   eff_XCONTEXT_Region        <= excW_addr(63 downto 62)   when (excW_pend = '1')   else COP0_20_XCONTEXT_Region;
+   eff_XCONTEXT_BadVPN        <= excW_addr(39 downto 13)   when (excW_pend = '1')   else COP0_20_XCONTEXT_BadVPN;
+   eff_ENTRYHI_virtualAddress <= excW_addr(39 downto 13)   when (excW_pendHi = '1') else COP0_10_ENTRYHI_virtualAddress;
+   eff_ENTRYHI_region         <= excW_addr(63 downto 62)   when (excW_pendHi = '1') else COP0_10_ENTRYHI_region;
+
    process (all)
    begin
    
@@ -380,19 +399,19 @@
          
