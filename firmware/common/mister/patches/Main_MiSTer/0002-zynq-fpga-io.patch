Title      : Zynq backend of fpga_io (ZYNQ)
Project    : fpga-mister (patch for Main_MiSTer b57370d)
Author     : Konstantin Schmidt (mr_pleasant@gmx.de)
Company    : OHRZ
Created    : 2026-10-28
Description:
  The HPS GPO/GPI registers of the Cyclone V become the PL bus hps_bus_axi on M_AXI_GP0 at
  0x40000000 (GPO 0x0, GPI 0x4, ID 0x8 = 0x5A4D5354). Cores are loaded through the Linux
  fpga_manager (sysfs flags/firmware, payload in /lib/firmware/mister/core.bin: a byte-swapped
  Xilinx .bin in the .rbf file, the "MiSTer" container header stays supported). GP0 is only
  accessed while fpga_manager reports "operating" and the ID register answers: an access to an
  unconfigured PL hangs the bus. Without a MiSTer design at startup Main_MiSTer loads menu.rbf.
  reboot() goes through systemd (no u-boot handover page, no reset manager); the alternative
  config of a core (u-boot core loader) is ignored. The Cyclone V code stays as it is without ZYNQ.

diff --git a/fpga_io.cpp b/fpga_io.cpp
index b64cfe5..8880098 100644
--- a/fpga_io.cpp
+++ b/fpga_io.cpp
@@ -17,6 +17,90 @@
 #include "shmem.h"
 #include "offload.h"
 
+#ifdef ZYNQ
+#include <sys/syscall.h>
+#include <linux/reboot.h>
+
+// Zynq-7000 (fpga-mister): the PL bus hps_bus_axi on M_AXI_GP0 replaces the HPS GPO/GPI
+// registers (GPO at 0x0, GPI at 0x4, ID at 0x8). The PL is configured by the Linux
+// fpga_manager; GP0 must not be touched while the PL is not configured (the access hangs).
+#define FPGA_REG_BASE 0x40000000
+#define FPGA_REG_SIZE 0x1000
+#define ZYNQ_REG_GPO  (0x0 / 4)
+#define ZYNQ_REG_GPI  (0x4 / 4)
+#define ZYNQ_REG_ID   (0x8 / 4)
+#define ZYNQ_ID       0x5A4D5354
+
+#define ZYNQ_FPGA_MGR "/sys/class/fpga_manager/fpga0/"
+#define ZYNQ_FW_DIR   "/lib/firmware/mister"
+#define ZYNQ_FW_NAME  "mister/core.bin"
+
+static volatile uint32_t *map_base;
+static int pl_ok = 0;
+
+static int zynq_sysfs_read(const char *attr, char *buf, int size)
+{
+	char path[128];
+	snprintf(path, sizeof(path), ZYNQ_FPGA_MGR "%s", attr);
+	int fd = open(path, O_RDONLY);
+	if (fd < 0) return -1;
+	int n = read(fd, buf, size - 1);
+	close(fd);
+	if (n < 0) return -1;
+	buf[n] = 0;
+	return n;
+}
+
+static int zynq_sysfs_write(const char *attr, const char *val)
+{
+	char path[128];
+	snprintf(path, sizeof(path), ZYNQ_FPGA_MGR "%s", attr);
+	int fd = open(path, O_WRONLY);
+	if (fd < 0)
+	{
+		printf("Couldn't open %s\n", path);
+		return 0;
+	}
+	int n = write(fd, val, strlen(val));
+	if (n < 0) printf("Writing %s to %s failed: %s\n", val, path, strerror(errno));
+	close(fd);
+	return n == (int)strlen(val);
+}
+
+// the PL holds a MiSTer design: fpga_manager reports a configured PL and the ID register answers
+static int zynq_pl_check()
+{
+	char state[64];
+	if (zynq_sysfs_read("state", state, sizeof(state)) < 0 || strcmp(state, "operating\n")) return 0;
+	if (!map_base) map_base = (volatile uint32_t*)shmem_map(FPGA_REG_BASE, FPGA_REG_SIZE);
+	if (!map_base) return 0;
+	return map_base[ZYNQ_REG_ID] == ZYNQ_ID;
+}
+
+// full configuration through the fpga_manager: the payload is a byte-swapped Xilinx .bin
+// (bootgen -process_bitstream bin), handed over as firmware file in /lib/firmware
+static int zynq_load(const void *data, size_t size)
+{
+	mkdir(ZYNQ_FW_DIR, 0755);
+	int fd = open("/lib/firmware/" ZYNQ_FW_NAME, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (fd < 0)
+	{
+		printf("Couldn't create /lib/firmware/%s\n", ZYNQ_FW_NAME);
+		return -1;
+	}
+	ssize_t n = write(fd, data, size);
+	close(fd);
+	if (n != (ssize_t)size) return -2;
+
+	// no GP0 access from here until the new design answers
+	pl_ok = 0;
+	if (!zynq_sysfs_write("flags", "0") || !zynq_sysfs_write("firmware", ZYNQ_FW_NAME)) return -3;
+	pl_ok = zynq_pl_check();
+	return pl_ok ? 0 : -4;
+}
+
+#else
+
 #include "fpga_base_addr_ac5.h"
 #include "fpga_manager.h"
 #include "fpga_system_manager.h"
@@ -423,6 +507,8 @@ static int make_env(const char *name, const char *cfg)
 	return 0;
 }
 
+#endif
+
 int fpga_load_rbf(const char *name, const char *cfg, const char *xml)
 {
 	OsdDisable();
@@ -431,10 +517,15 @@ int fpga_load_rbf(const char *name, const char *cfg, const char *xml)
 
 	if(cfg)
 	{
+#ifdef ZYNQ
+		// the alternative config is handed to u-boot on the DE10-Nano: no u-boot core loader here
+		printf("Alternative config %s ignored (needs the u-boot core loader)\n", cfg);
+#else
 		fpga_core_reset(1);
 		make_env(name, cfg);
 		do_bridge(0);
 		reboot(0);
+#endif
 	}
 
 	printf("Loading RBF: %s\n", name);
@@ -486,6 +577,13 @@ int fpga_load_rbf(const char *name, const char *cfg, const char *xml)
 						sz = *(uint32_t*)(((uint8_t*)buf) + 12);
 						p = (void*)(((uint8_t*)buf) + 16);
 					}
+#ifdef ZYNQ
+					ret = zynq_load(p, sz);
+					if (ret)
+					{
+						printf("Error %d while loading %s\n", ret, path);
+					}
+#else
 					do_bridge(0);
 					ret = socfpga_load(p, sz);
 					if (ret)
@@ -496,6 +594,7 @@ int fpga_load_rbf(const char *name, const char *cfg, const char *xml)
 					{
 						do_bridge(1);
 					}
+#endif
 				}
 				free(buf);
 			}
@@ -511,9 +610,38 @@ static uint32_t gpo_copy = 0;
 void inline fpga_gpo_write(uint32_t value)
 {
 	gpo_copy = value;
+#ifdef ZYNQ
+	if (pl_ok) map_base[ZYNQ_REG_GPO] = value;
+#else
 	writel(value, (void*)(SOCFPGA_MGR_ADDRESS + 0x10));
+#endif
+}
+
+#ifdef ZYNQ
+// without a MiSTer design in the PL, writes are dropped and GPI reads as "not ready" (bit 31)
+#define fpga_gpo_writeN(value) do { if (pl_ok) map_base[ZYNQ_REG_GPO] = (value); } while (0)
+#define fpga_gpo_read() gpo_copy
+#define fpga_gpi_read() (pl_ok ? (int)map_base[ZYNQ_REG_GPI] : -1)
+
+// no lightweight HPS-to-FPGA bridge
+void fpga_core_write(uint32_t, uint32_t)
+{
+}
+
+uint32_t fpga_core_read(uint32_t)
+{
+	return 0;
 }
 
+int fpga_io_init()
+{
+	pl_ok = zynq_pl_check();
+	if (!pl_ok) printf("No MiSTer design in the PL (fpga_manager state, ID register at 0x%08X)\n", FPGA_REG_BASE);
+
+	fpga_gpo_write(0);
+	return 0;
+}
+#else
 #define fpga_gpo_writeN(value) writel((value), (void*)(SOCFPGA_MGR_ADDRESS + 0x10))
 #define fpga_gpo_read() gpo_copy //readl((void*)(SOCFPGA_MGR_ADDRESS + 0x10))
 #define fpga_gpi_read() (int)readl((void*)(SOCFPGA_MGR_ADDRESS + 0x14))
@@ -537,6 +665,7 @@ int fpga_io_init()
 	fpga_gpo_write(0);
 	return 0;
 }
+#endif
 
 int fpga_core_id()
 {
@@ -592,6 +721,12 @@ void reboot(int cold)
 
 	usleep(500000);
 
+#ifdef ZYNQ
+	// no u-boot handover: a clean reboot through systemd, the reboot syscall when that fails
+	(void)cold;
+	if (system("systemctl --no-block reboot"))
+		syscall(SYS_reboot, LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, LINUX_REBOOT_CMD_RESTART, NULL);
+#else
 	void* buf = shmem_map(0x1FFFF000, 0x1000);
 	if (buf)
 	{
@@ -602,6 +737,7 @@ void reboot(int cold)
 	}
 
 	writel(1, &reset_regs->ctrl);
+#endif
 	while (1) sleep(1);
 }
 
@@ -659,7 +795,11 @@ int is_fpga_ready(int quick)
 		return (fpga_gpi_read() >= 0);
 	}
 
+#ifdef ZYNQ
+	return pl_ok = zynq_pl_check();
+#else
 	return fpgamgr_test_fpga_ready();
+#endif
 }
 
 #define SSPI_STROBE  (1<<17)
@@ -678,17 +818,32 @@ void fpga_wait_to_reset()
 
 	fpga_core_reset(1);
 
+#ifdef ZYNQ
+	// no u-boot to keep the loaded design across a warm reboot: restart Main_MiSTer on it
+	// once the PL holds a MiSTer design and the bus answers
+	while (!is_fpga_ready(0) || !is_fpga_ready(1))
+	{
+		sleep(1);
+	}
+	app_restart(NULL);
+#else
 	while (!is_fpga_ready(0))
 	{
 		sleep(1);
 	}
 	reboot(0);
+#endif
 }
 
 uint16_t fpga_spi(uint16_t word)
 {
 	uint32_t gpo = (fpga_gpo_read() & ~(0xFFFF | SSPI_STROBE)) | word;
 
+#ifdef ZYNQ
+	// no MiSTer design in the PL (before the menu core is loaded): nothing to talk to
+	if (!pl_ok) return 0;
+#endif
+
 	fpga_gpo_write(gpo);
 	fpga_gpo_write(gpo | SSPI_STROBE);
 
diff --git a/main.cpp b/main.cpp
index f1eaf82..8e75ae3 100644
--- a/main.cpp
+++ b/main.cpp
@@ -64,6 +64,15 @@ int main(int argc, char *argv[])
 
 	if (!is_fpga_ready(1))
 	{
+#ifdef ZYNQ
+		// no u-boot core loader: load the menu core into the PL (Main_MiSTer restarts on it),
+		// unless this start already follows a load of the menu core
+		if (argc < 2 || strcasecmp(argv[1], "menu.rbf"))
+		{
+			printf("\nNo MiSTer design in the PL, loading menu.rbf\n");
+			fpga_load_rbf("menu.rbf");
+		}
+#endif
 		printf("\nGPI[31]==1. FPGA is uninitialized or incompatible core loaded.\n");
 		printf("Quitting. Bye bye...\n");
 		exit(0);
