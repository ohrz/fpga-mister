# ----------------------------------------------------------------------------------
#  Title      : tmpfs for the core bitstreams of Main_MiSTer
#  Project    : fpga-mister
#  File       : usr-lib-firmware-mister.mount (/etc/systemd/system)
#  Author     : Konstantin Schmidt (mr_pleasant@gmx.de)
#  Company    : OHRZ
#  Created    : 2026-10-28
# ----------------------------------------------------------------------------------
#  Description: Main_MiSTer (ZYNQ) writes every core it loads to /lib/firmware/mister/core.bin
#               and hands it to the fpga_manager (firmware loader search path /lib/firmware):
#               a tmpfs spares the SD card. /lib is /usr/lib on Ubuntu 24.04 (merged /usr),
#               a mount unit needs the canonical path.
# ----------------------------------------------------------------------------------
#  Copyright (c) 2026 by OHRZ
# ----------------------------------------------------------------------------------

[Unit]
Description=tmpfs for the core bitstreams of Main_MiSTer

[Mount]
What=tmpfs
Where=/usr/lib/firmware/mister
Type=tmpfs
Options=mode=0755,size=16M
