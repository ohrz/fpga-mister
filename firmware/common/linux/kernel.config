# Kernel options on top of the Xilinx defconfig for every board, merged by FLOW=kernel make build
# (scripts/kconfig/merge_config.sh, then olddefconfig) before the optional board fragment
# firmware/targets/<platform>/files/kernel.config.
#
# UIO as module: the working board kernels differ from the defconfig only here.
CONFIG_UIO=m
CONFIG_UIO_PDRV_GENIRQ=m
